{
    "name": "ranksphere/ranksphere-wp",
    "description": "Connects a WordPress site to RankSphere.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://ranksphere.cloud",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "php-stubs/wordpress-tests-stubs": "^7.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^9.6",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.4",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "RankSphere\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RankSphere\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=2G",
        "test:unit": "phpunit -c phpunit-unit.xml.dist",
        "test:integration": "phpunit -c phpunit.xml.dist",
        "check-versions": "php bin/check-versions.php",
        "check": [
            "@composer validate --strict",
            "@check-versions",
            "@lint",
            "@analyse",
            "@test:unit"
        ]
    }
}
