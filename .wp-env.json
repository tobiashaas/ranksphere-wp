{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.1",
	"plugins": [
		".",
		"https://downloads.wordpress.org/plugin/wordpress-seo.latest-stable.zip",
		"https://downloads.wordpress.org/plugin/seo-by-rank-math.latest-stable.zip",
		"https://downloads.wordpress.org/plugin/wp-seopress.latest-stable.zip",
		"https://downloads.wordpress.org/plugin/all-in-one-seo-pack.latest-stable.zip",
		"https://downloads.wordpress.org/plugin/autodescription.latest-stable.zip",
		"https://downloads.wordpress.org/plugin/slim-seo.latest-stable.zip"
	],
	"config": {
		"WP_DEBUG": true,
		"SCRIPT_DEBUG": true
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp plugin deactivate --all --exclude=ranksphere-wp && wp-env run cli wp rewrite structure /%postname%/"
	}
}
