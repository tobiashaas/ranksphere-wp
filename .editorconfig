# WordPress coding standards: tabs for PHP, JS and CSS.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{yml,yaml,md,json}]
indent_style = space
indent_size = 2

[{composer.json,package.json}]
indent_size = 4

[*.txt]
trim_trailing_whitespace = false
